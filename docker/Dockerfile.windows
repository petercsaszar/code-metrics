# Windows Server Core image with .NET SDK and Python venv
# Supports running the analyzer in Windows containers mode
#
# Supports two analysis modes:
#   - Milestone mode (default): Analyzes code at predefined milestones, tracks evolution over time
#   - Latest snapshot mode: Analyzes HEAD of each project's default branch with metric thresholds
#
# Set ANALYSIS_MODE environment variable to control which mode is used:
#   docker run ... -e ANALYSIS_MODE=milestone ... (default, milestone-based analysis)
#   docker run ... -e ANALYSIS_MODE=latest_snapshot ... (latest HEAD analysis with thresholds)

# Stage 1: build and publish the CodeMetricsAnalyzer
FROM mcr.microsoft.com/dotnet/sdk:8.0-windowsservercore-ltsc2019 AS build
SHELL ["powershell", "-NoProfile", "-Command"]
WORKDIR C:\\src

# Copy only the analyzer project and restore/publish
COPY CodeMetricsAnalyzer/ ./CodeMetricsAnalyzer/
RUN dotnet restore C:\src\CodeMetricsAnalyzer\CodeMetricsAnalyzer.sln ; \
    dotnet publish C:\src\CodeMetricsAnalyzer\CodeMetricsAnalyzer\CodeMetricsAnalyzer.csproj -c Release -o C:\app\publish

# Stage 2: runtime image with dotnet SDK and Python venv
FROM mcr.microsoft.com/dotnet/sdk:8.0-windowsservercore-ltsc2019
SHELL ["powershell", "-NoProfile", "-Command"]

# Install Chocolatey and packages
ENV chocolateyVersion=1.4.4
RUN \
    # Download
    Invoke-WebRequest -OutFile C:\chocolatey-install.ps1 -URI https://community.chocolatey.org/install.ps1; \
    # Install Chocolatey
    Invoke-Expression C:\chocolatey-install.ps1; \
    # Cleanup
    Remove-Item C:\chocolatey-install.ps1; \
    # Install Python
    choco install -y python --version=3.11.6; \
    # Install Git
    choco install -y git
# Install Visual Studio Build Tools (MSBuild)
RUN powershell -Command \
        Invoke-WebRequest https://aka.ms/vs/17/release/vs_buildtools.exe -OutFile vs_buildtools.exe ; \
        Start-Process vs_buildtools.exe -Wait -ArgumentList \
            '--quiet --wait --norestart --nocache \
             --add Microsoft.VisualStudio.Workload.MSBuildTools \
             --add Microsoft.Net.Component.4.6.1.TargetingPack \
             --add Microsoft.Net.Component.4.6.2.TargetingPack \
             --add Microsoft.Net.Component.4.7.2.TargetingPack \
             --add Microsoft.Net.Component.4.8.TargetingPack' ; \
        Remove-Item vs_buildtools.exe

# Create directories
RUN New-Item -ItemType Directory -Path C:\opt -Force -ErrorAction SilentlyContinue | Out-Null ; \
    New-Item -ItemType Directory -Path C:\opt\bulk_analyzer | Out-Null ; \
    New-Item -ItemType Directory -Path C:\opt\CodeMetricsAnalyzer | Out-Null ; \
    New-Item -ItemType Directory -Path C:\Tools -Force -ErrorAction SilentlyContinue | Out-Null

# Copy published dotnet analyzer
COPY --from=build "C:\\app\\publish" "C:\\opt\\CodeMetricsAnalyzer"

# Copy python analyzer package
COPY bulk_analyzer "C:\\opt\\bulk_analyzer"
WORKDIR C:\\opt\\bulk_analyzer

# Create venv and install python deps (use venv's python for reliability)
RUN $ErrorActionPreference = 'Stop' ; \
    python --version ; \
    python -m venv C:\opt\venv ; \
    C:\opt\venv\Scripts\python.exe -m pip install --upgrade pip setuptools wheel ; \
    C:\opt\venv\Scripts\python.exe -m pip install --no-cache-dir -r C:\opt\bulk_analyzer\requirements.txt

# Fetch dotnet-install.ps1 and create a wrapper .cmd so our Python script can call it
RUN Invoke-WebRequest -Uri https://dot.net/v1/dotnet-install.ps1 -OutFile C:\Tools\dotnet-install.ps1 ; \
    Set-ItemProperty -Path C:\Tools\dotnet-install.ps1 -Name IsReadOnly -Value $false ; \
    New-Item -Path C:\Tools\dotnet-install.cmd -ItemType File -Force | Out-Null ; \
    Add-Content -Path C:\Tools\dotnet-install.cmd -Value '@echo off' ; \
    Add-Content -Path C:\Tools\dotnet-install.cmd -Value '"%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -NoProfile -ExecutionPolicy Bypass -File C:\\Tools\\dotnet-install.ps1 %*' ; \
    $env:Path = 'C:\\Program Files\\dotnet;' + $env:Path

# Environment
ENV PATH="C:\\opt\\venv\\Scripts;C:\\Program Files\\dotnet;C:\\Program Files\\Git\\cmd;C:\\Program Files\\Git\\bin;C:\\ProgramData\\chocolatey\\bin;%PATH%"
ENV PYTHONPATH="C:\\opt"
ENV ANALYZER_CONFIG="C:\\opt\\bulk_analyzer\\config.yml"
ENV CONFIG_PATH="C:\\opt\\bulk_analyzer\\config.yml"
ENV DOTNET_INSTALL_SCRIPT="C:\\Tools\\dotnet-install.cmd"
ENV DOTNET_INSTALL_DIR="C:\\Program Files\\dotnet"
ENV DOTNET_ROOT="C:\\Program Files\\dotnet"

# Analysis mode: "milestone" (default) or "latest_snapshot"
# Use "latest_snapshot" to analyze HEAD of each project's default branch instead of milestones.
ENV ANALYSIS_MODE=milestone

# ENV MSBUILD_EXE_PATH="C:\\BuildTools\\MSBuild\\Current\\Bin\\MSBuild.exe"
# ENV MSBUILD_PATH="C:\\BuildTools\\MSBuild\\Current\\Bin"

# Entry point: run the container runner (can be overridden)
ENTRYPOINT ["C:\\opt\\venv\\Scripts\\python.exe", "-m", "bulk_analyzer.container_runner"]
